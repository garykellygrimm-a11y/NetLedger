  "query": "\n        SELECT cidr AS \"cidr: IpNet\", name, cidr >> $1 AS \"contains_new!\"\n        FROM subnet\n        WHERE parent_id IS NOT DISTINCT FROM $2 AND cidr && $1\n        LIMIT 1\n        ",
