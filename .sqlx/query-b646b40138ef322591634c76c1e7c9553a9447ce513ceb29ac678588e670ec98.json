{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id AS session_id, s.last_seen_at, s.expires_at,\n               a.id AS account_id, a.username, a.role, a.disabled_at\n        FROM session s\n        JOIN account a ON a.id = s.account_id\n        WHERE s.token_hash = $1\n        ",
