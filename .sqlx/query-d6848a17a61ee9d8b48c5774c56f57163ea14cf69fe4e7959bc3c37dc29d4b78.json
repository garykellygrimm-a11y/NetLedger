  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id AS token_id, t.expires_at, t.revoked_at, t.last_used_at,\n               a.id AS account_id, a.username, a.role, a.disabled_at\n        FROM api_token t\n        JOIN account a ON a.id = t.account_id\n        WHERE t.token_hash = $1\n        ",
