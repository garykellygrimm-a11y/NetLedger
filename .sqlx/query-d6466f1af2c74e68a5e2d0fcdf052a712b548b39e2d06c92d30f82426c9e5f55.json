{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.username, a.role, a.disabled_at, i.id AS identity_id, i.secret_hash\n        FROM account a\n        JOIN identity i ON i.account_id = a.id AND i.kind = 'password'\n        WHERE a.username = $1\n        ",
